{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "mcp": {
        "playwright": {
            "type": "local",
            "enabled": true,
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "mcp/playwright"
            ]
        }
    },
    "provider": {
        "local": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Llama.cpp",
            "options": {
                "baseURL": "http://host.docker.internal:8080/v1"
            },
            "models": {
                "Qwen3.5-4B-UD-Q4_K_XL-MTP": {
                    "name": "Qwen3.5-4B-UD-Q4_K_XL-MTP"
                }
            }
        }
    }
}